{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"files": {
		"includes": ["**", "!!**/dist"],
		"ignoreUnknown": true
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"recommended": true,
				"noExcessiveCognitiveComplexity": "warn"
			},
			"a11y": { "recommended": true },
			"correctness": { "recommended": true },
			"security": { "recommended": true, "noSecrets": "error" },
			"performance": { "recommended": true },
			"style": { "recommended": true },
			"nursery": { "recommended": true, "useDestructuring": "on" },
			"suspicious": { "recommended": true }
		},
		"domains": {
			"project": "recommended",
			"test": "recommended",
			"types": "recommended"
		}
	},
	"javascript": {},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"recommended": true,
				"organizeImports": "off",
				"useSortedInterfaceMembers": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/lib/downdetector/**", "src/cli/**", "src/main.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			}
		}
	]
}
