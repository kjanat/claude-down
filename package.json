{
	"name": "claude-down",
	"version": "0.7.1",
	"description": "Is claude code down? Probably...",
	"keywords": [
		"anthropic",
		"claude",
		"cli",
		"downdetector",
		"dreamcli",
		"statuspage",
		"ansispeck"
	],
	"homepage": "https://claude-down.kjanat.dev",
	"bugs": {
		"url": "https://github.com/kjanat/claude-down/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/claude-down.git"
	},
	"license": "MIT",
	"author": "Kaj Kowalski <info@kajkowalski.nl> (https://github.com/kjanat)",
	"type": "module",
	"imports": {
		"#claude-down": "./src/index.ts",
		"#claude-down/cli": "./src/cli/index.ts",
		"#claude-down/browser": "./src/browser.ts",
		"#claude-down/*": "./src/*.ts",
		"#demo/*": "./demo/*.ts",
		"#pkg": "./package.json",
		"#test/*": "./test/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser/browser.d.ts",
			"default": "./dist/browser/browser.js"
		},
		"./package.json": "./package.json"
	},
	"jsdelivr": "./dist/browser/browser.js",
	"bin": {
		"claude-down": "dist/bin/cli.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"bd": "bun run build",
		"build": "tsdown",
		"check": "biome check",
		"dev": "bun demo/index.html",
		"fmt": "bunx dprint fmt",
		"lint": "biome lint",
		"local": "bun run build -l warn && bun link",
		"prepublishOnly": "bun run build -l warn",
		"preview": "bun start",
		"publish:npm": "npm view \"$(jq -r '\"\\(.name)@\\(.version)\"' package.json)\" version >/dev/null 2>&1 && echo already published, skipping || bunx npm@11 publish",
		"publish:pkg-pr-new": "bunx pkg-pr-new publish --bun --bin --packageManager=npm,bun,pnpm",
		"publishChecks": "e18e-cli analyze; attw; bunx publint --pack bun --strict",
		"site:build": "bun build --compile --target=browser ./demo/index.html --outdir=dist/site --minify",
		"prestart": "bun site:build",
		"start": "bunx serve dist/site",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"ansispeck": "^0.4.1",
		"dreamcli": "npm:@kjanat/dreamcli@^3.0.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/node": "^26.1.2",
		"biome": "npm:@biomejs/biome@^2.5.6",
		"statuspage.io": "^3.5",
		"tsdown": "^0.22",
		"typescript": "^7"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3",
		"node": ">=22.18.0"
	},
	"devEngines": {
		"packageManager": [
			{
				"name": "bun",
				"onFail": "warn"
			}
		],
		"runtime": [
			{
				"name": "bun",
				"onFail": "warn"
			}
		]
	},
	"volta": {
		"node": "26.5.0",
		"npm": "11.18.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	}
}
