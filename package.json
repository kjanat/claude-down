{
	"name": "claude-down",
	"version": "0.8.0",
	"description": "Is claude code down? Probably...",
	"keywords": [
		"anthropic",
		"claude",
		"cli",
		"downdetector",
		"statuspage",
		"ansispeck",
		"dreamcli"
	],
	"homepage": "https://claude-down.kjanat.dev",
	"bugs": {
		"url": "https://github.com/kjanat/claude-down/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/claude-down.git"
	},
	"license": "MIT",
	"author": "Kaj Kowalski <info@kajkowalski.nl> (https://github.com/kjanat)",
	"type": "module",
	"imports": {
		"#claude-down": "./src/index.ts",
		"#claude-down/cli": "./src/cli/index.ts",
		"#claude-down/browser": "./src/browser.ts",
		"#claude-down/*": "./src/*.ts",
		"#demo/*": "./demo/*.ts",
		"#pkg": "./package.json",
		"#test/*": "./test/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser/browser.d.ts",
			"default": "./dist/browser/browser.js"
		},
		"./package.json": "./package.json"
	},
	"jsdelivr": "./dist/browser/browser.js",
	"bin": {
		"claude-down": "dist/bin/cli.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"bd": "run build",
		"build": "tsdown",
		"check": "biome check",
		"claude-down": "bun --bun src/main.ts",
		"dev": "bun demo/index.html",
		"fmt": "run dprint fmt",
		"lint": "biome lint",
		"local": "run build -l warn && bun link",
		"prepublishOnly": "run build -l warn",
		"preview": "bun start",
		"pubcheck:attw": "run @arethetypeswrong/cli",
		"pubcheck:e18e": "run @e18e/cli analyze --log-level warn",
		"pubcheck:publint": "run publint --pack bun --strict",
		"publish:npm": "npm_cli=\"npm@$(bun -p'require(\"#pkg\").volta.npm')\" bash -c 'bun info --json | jq -e \".versions | index(env.npm_package_version)\" >/dev/null; case $? in 0) echo \"already published, skipping\";; 1) [[ \"$npm_package_version\" =~ ^[0-9]+([.][0-9]+){2}$ ]] || set -- \"$@\" --tag next; run \"$npm_cli\" publish \"$@\";; *) exit 1;; esac' --",
		"publish:pkg-pr-new": "run pkg-pr-new publish --bun --previewVersion --bin --packageManager=npm,bun,pnpm",
		"publishChecks": "run -pk pubcheck:attw pubcheck:e18e pubcheck:publint",
		"site:build": "PP=\"$(test $GITHUB_ACTIONS && bun -p\"require('#pkg').homepage\" || echo '.')/\" bun build --compile --target=browser ./demo/index.html --outdir=\"${DIR:-dist/site}\" --minify --production --public-path=\"${PP}\"",
		"prestart": "run site:build",
		"start": "run serve \"${DIR:-dist/site}\"",
		"test": "bun test",
		"typecheck": "run tsc --noEmit",
		"url:npm": "Url=\"https://npm.im/package/$npm_package_name/v/$npm_package_version\"; if [[ $GITHUB_OUTPUT ]]; then echo \"url=$Url\" >> \"$GITHUB_OUTPUT\"; else echo \"$Url\"; fi",
		"volta:pin": "volta pin node@$npm_package_config_versions_node npm@$npm_package_config_versions_npm && node --version > .node-version || echo 'run with npm run volta:pin'"
	},
	"config": {
		"versions": {
			"node": "latest",
			"npm": "11"
		}
	},
	"dependencies": {
		"ansispeck": "^0.4.1",
		"dreamcli": "npm:@kjanat/dreamcli@^4.0.0-rc.2"
	},
	"devDependencies": {
		"@types/bun": "^1.3",
		"@types/node": "^26.2.0",
		"biome": "npm:@biomejs/biome@^2.5.8",
		"pkg-pr-new": "^0.0.88",
		"runner-run": "^0.25.1",
		"statuspage.io": "^3.5",
		"tsdown": "^0.22",
		"typescript": "^7"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3",
		"node": ">=22.18.0"
	},
	"devEngines": {
		"packageManager": [
			{
				"name": "bun",
				"onFail": "warn"
			},
			{
				"name": "npm",
				"onFail": "warn",
				"version": ">=11"
			}
		],
		"runtime": [
			{
				"name": "bun",
				"onFail": "warn",
				"version": ">=1.3.14"
			},
			{
				"name": "node",
				"onFail": "warn",
				"version": ">=26"
			}
		]
	},
	"volta": {
		"node": "26.6.0",
		"npm": "11.19.0"
	},
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	}
}
