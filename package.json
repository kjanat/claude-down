{
	"name": "claude-down",
	"version": "0.5.0",
	"description": "Is claude code down? Probably...",
	"homepage": "https://kjanat.github.io/claude-down/",
	"bugs": {
		"url": "https://github.com/kjanat/claude-down/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/claude-down.git"
	},
	"license": "MIT",
	"author": "Kaj Kowalski <info@kajkowalski.nl> (https://github.com/kjanat)",
	"type": "module",
	"jsdelivr": "./dist/browser/browser.js",
	"imports": {
		"#claude-down": "./src/index.ts",
		"#claude-down/cli": "./src/cli/index.ts",
		"#claude-down/browser": "./src/browser.ts",
		"#claude-down/*": "./src/*.ts",
		"#test/*": "./test/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./browser": {
			"types": "./dist/browser/browser.d.ts",
			"default": "./dist/browser/browser.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"claude-down": "dist/bin/cli.mjs"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"scripts": {
		"bd": "bun run build",
		"build": "tsdown",
		"check": "biome check",
		"fmt": "bunx dprint fmt",
		"lint": "biome lint",
		"local": "bun run build -l warn && bun link",
		"prepublishOnly": "bun run build -l warn",
		"publishChecks": "e18e-cli analyze; attw; bunx publint --pack bun --strict",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"dev": "bun demo/index.html",
		"preview": "bun start",
		"site:build": "bun build --compile --target=browser ./demo/index.html --outdir=dist/site --minify",
		"prestart": "bun site:build",
		"start": "bunx serve dist/site"
	},
	"dependencies": {
		"@kjanat/dreamcli": "^2.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.3",
		"statuspage.io": "^3.5.0",
		"tsdown": "^0.22.2",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3",
		"node": ">=22.18.0"
	},
	"devEngines": {
		"packageManager": [{
			"name": "bun",
			"onFail": "warn"
		}],
		"runtime": [{
			"name": "bun",
			"onFail": "warn"
		}]
	}
}
